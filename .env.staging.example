# Copy to .env.staging on the authorized staging host and replace every placeholder.
# Keep this file out of version control; never reuse production credentials.
STAGING_DEPLOY_AUTHORIZED=false
STAGING_CHANGE_ID=replace-with-approved-change-id
STAGING_OPERATOR=replace-with-authorized-operator
STAGING_DOMAIN=staging.example.net
POSTGRES_DB=shopademia_staging_replace
POSTGRES_USER=shopademia_staging_owner
POSTGRES_PASSWORD=replace-with-a-unique-random-secret-at-least-32-characters
POSTGRES_APP_PASSWORD=replace-with-a-different-random-secret-at-least-32-characters
POSTGRES_MIGRATION_PASSWORD=replace-with-another-random-secret-at-least-32-characters
DATABASE_URL=postgresql://shopademia_app:replace-with-app-secret@database:5432/shopademia_staging_replace
MIGRATION_DATABASE_URL=postgresql://shopademia_migrator:replace-with-migration-secret@database:5432/shopademia_staging_replace
JWT_SECRET=replace-with-a-unique-random-secret-at-least-64-characters
MFA_ENCRYPTION_KEY=replace-with-a-unique-random-64-character-hex-secret
ADMIN_EMAIL=staging-admin@example.net
ADMIN_PASSWORD=replace-with-a-unique-staging-admin-password-at-least-20-characters
