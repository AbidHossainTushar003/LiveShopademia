DOMAIN=store.example.com

POSTGRES_DB=shopademia
POSTGRES_USER=shopademia_owner
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-secret
POSTGRES_APP_PASSWORD=replace-with-a-different-random-64-character-hex-secret
DATABASE_URL=postgres://shopademia_app:replace-with-the-app-password@database:5432/shopademia
DATABASE_SSL=false

ADMIN_EMAIL=orders@example.com
ADMIN_PASSWORD=replace-with-a-unique-random-password-of-at-least-32-characters
JWT_SECRET=replace-with-a-different-random-secret-of-at-least-64-characters

BACKUP_AGE_RECIPIENT=replace-with-your-age-public-recipient
DELIVERY_ADVANCE_CHARGE=100
DEMO_USD_TO_BDT=120
FAKE_STORE_API_URL=https://fakestoreapi.com/products
