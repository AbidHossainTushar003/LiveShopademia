<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/dashboard_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard"
            android:textColor="@color/trust_blue"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profile_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dashboard_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="12dp"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/dashboard_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/commerce_orange"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/dashboard_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/orders_metric"
                style="@style/MetricCard"
                android:text="Orders" />

            <TextView
                android:id="@+id/products_metric"
                style="@style/MetricCard"
                android:layout_marginTop="10dp"
                android:text="Products" />

            <TextView
                android:id="@+id/stock_metric"
                style="@style/MetricCard"
                android:layout_marginTop="10dp"
                android:text="Stock units" />

            <TextView
                android:id="@+id/availability_metric"
                style="@style/MetricCard"
                android:layout_marginTop="10dp"
                android:text="Availability" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_products"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="52dp"
            android:text="@string/products" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_orders"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="@string/orders" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_refresh"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/refresh" />

        <TextView
            android:id="@+id/logout_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_logout"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/logout" />
    </LinearLayout>
</ScrollView>
