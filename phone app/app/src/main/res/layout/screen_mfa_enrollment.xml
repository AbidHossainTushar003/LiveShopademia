<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Secure your platform-admin account"
            android:textColor="@color/trust_blue"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Add this account to an authenticator app. The setup key is shown only for this enrollment step."
            android:textColor="@color/muted_ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/totp_secret"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mfa_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:padding="12dp"
            android:textColor="@color/trust_blue_dark"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/input_enrollment_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:autofillHints="oneTimeCode"
            android:hint="@string/authenticator_code"
            android:inputType="number"
            android:maxLength="6"
            android:maxLines="1"
            android:minHeight="56dp" />

        <TextView
            android:id="@+id/mfa_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="12dp"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/mfa_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/commerce_orange"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_complete_enrollment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="52dp"
            android:text="Verify and continue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_enrollment"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="Cancel sign-in" />
    </LinearLayout>
</ScrollView>
