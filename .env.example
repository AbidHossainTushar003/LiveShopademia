PORT=3000
NODE_ENV=development
TRUST_PROXY_HOPS=0
PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgres://shopademia:replace-with-a-local-random-secret@127.0.0.1:5432/shopademia
DATABASE_SSL=false
postgres://shopademia:local_dev_password_change_me@127.0.0.1:5432/shopademia
POSTGRES_DB=shopademia
